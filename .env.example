# ==========================================================================
#  Copy to .env and fill in.  NEVER commit .env — leaked broker keys can
#  drain a real account. .env is already in .gitignore; keep it that way.
#  Paste keys with NO trailing spaces (the bot strips them, but be careful).
# ==========================================================================

# ##########################################################################
#  AI TRADING BOT  (stocks/crypto via Alpaca — the primary system)
# ##########################################################################

# === Claude / Anthropic — the analysis brain =============================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# COST WARNING. This is charged per use on your Anthropic API account, which
# is separate from a Claude.ai subscription. A scan makes ~2 calls per symbol,
# so an 8-symbol watchlist every 15 minutes is ~26 scans a trading day.
# Rough cost per full trading day at that rate:
#   claude-fable-5    ($10/$50 per Mtok)  ~$30/day   <- the guide's model
#   claude-opus-5     ($5/$25)            ~$15/day
#   claude-sonnet-5   ($3/$15)            ~$10/day
#   claude-haiku-4-5  ($1/$5)             ~$3/day    <- start here while testing
# Shorten WATCHLIST and raise SCAN_INTERVAL_MINUTES to cut this further.
# Fable 5 also requires 30-day data retention on your org (400 under ZDR).
CLAUDE_MODEL=claude-fable-5
# low | medium | high | xhigh | max — controls reasoning depth and cost.
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000

# === OpenRouter (optional) — one key, many models ========================
# Set LLM_PROVIDER=openrouter to route analysis through OpenRouter instead.
LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# === Which broker ========================================================
# auto | alpaca | ig | t212 | simulated
# auto picks IG if IG keys are set, else Trading 212, else Alpaca, else the
# local simulator.
BROKER=auto

# Run a SECOND broker alongside the first. Both accounts are then treated as
# ONE portfolio: the daily stop, drawdown pause, position count and
# correlation cap all apply to the combined book. Without this, two brokers
# means two independent sets of limits and a -3% day at each is a -6% day
# that nothing stopped. See docs/multi-broker.md.
SECONDARY_BROKER=
# Which venue handles which symbol. Anything unlisted goes to the primary.
# e.g. BROKER_ROUTES=FTSE=ig,UK100=ig,AAPL=t212,MSFT=t212
BROKER_ROUTES=

# === Broker: Trading 212 (Invest / Stocks ISA, UK) =======================
# READ docs/trading-212.md FIRST.
#
# Real shares, no leverage, and inside a Stocks ISA the gains are untaxed —
# the most benign thing this bot can trade. But the API has NO BRACKET
# ORDERS: the stop is a separate order placed AFTER the entry fills, so
# there is a brief window where the position is unprotected, and a crash
# inside it leaves shares with no stop. That is the trade-off.
#
# Get the key in the app: Settings -> API (Beta). Invest and Stocks ISA
# accounts only — the API is not available for CFD accounts.
# Long only: short signals are refused.
T212_API_KEY=
# Only if your key has a separate secret (newer keys use Basic auth).
T212_API_SECRET=
# true = demo.trading212.com. This is the T212 half of the live switch:
# live needs T212_DEMO=false AND TRADING_MODE=live AND CONFIRM_LIVE.
T212_DEMO=true
# Pin symbols to T212 tickers so nothing has to be looked up.
# e.g. T212_TICKERS=AAPL=AAPL_US_EQ,VOD=VODl_EQ
T212_TICKERS=
# Seconds to wait for a market entry to fill before giving up on its stop.
# Every second here is a second the position is unprotected.
T212_FILL_TIMEOUT=20
#
# NOTE: Trading 212 has NO price API. With BROKER=t212 the bot reads bars
# from Alpaca instead — free PAPER keys are enough and are used for DATA
# ONLY, never for orders. Set ALPACA_API_KEY / ALPACA_SECRET_KEY below.

# === Broker: Alpaca — USE PAPER KEYS FIRST ===============================
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true
# iex = free feed, sip = paid full-market feed
ALPACA_DATA_FEED=iex

# === Broker: IG (IG Index / IG Markets, UK) ==============================
# READ docs/ig-spread-betting.md FIRST.
#
# IG trades SPREAD BETS and CFDs: leveraged derivatives, not shares. You do not
# own anything, size is a stake in currency PER POINT (not a share count), and
# £500 of margin can carry £10,000 of exposure. A 5% adverse move is your whole
# deposit, not 5% of it. IG demo accounts are spread bet / CFD only — there is
# no unleveraged share-dealing demo.
#
# IG_USERNAME and IG_PASSWORD are your IG WEB login, not the API key.
# Get the API key from My IG -> Settings -> API keys, and turn OFF the
# "encrypted passwords" option for it.
# A DEMO key only works against demo-api.ig.com — demo and live keys are not
# interchangeable, so IG_DEMO must match the key you generated.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
# Leave blank to use whichever account IG returns as current.
IG_ACCOUNT_ID=
# true = demo (demo-api.ig.com). This is the IG half of the live switch:
# live trading needs IG_DEMO=false AND TRADING_MODE=live AND CONFIRM_LIVE.
IG_DEMO=true
# Pin symbols to IG "epics" so the bot does not have to guess which market you
# meant. Read the epic off the market's URL on IG's own platform.
# e.g. IG_EPICS=FTSE=IX.D.FTSE.DAILY.IP,AAPL=UA.D.AAPL.CASH.IP
IG_EPICS=
# Gearing ceiling: the most exposure one position may carry, as % of equity.
# 300 = at most 3x equity. MAX_POSITION_PCT does not apply to spread bets —
# this replaces it. Lower it to trade smaller. At 300% with 1% risk, stops
# closer than 0.33% get trimmed and risk less than your 1% budget.
IG_MAX_EXPOSURE_PCT=300.0
# Assumed deposit factor, only used to reject an obviously unfundable stake
# before IG sees it. IG's real requirement varies by market and IG is the
# authority; lower this if you trade markets with higher margin.
IG_MARGIN_PCT=20.0
# Smallest stake IG accepts, in currency per point. Market-dependent.
IG_MIN_DEAL_SIZE=0.5
# Seconds to leave between IG calls. IG's limits are per minute and a scan
# bursts; raise this if you see 429s.
IG_MIN_REQUEST_INTERVAL=1.0
# Account currency, for labelling sizes. IG reports the real one on login.
IG_CURRENCY=GBP

# === News API — feeds headlines to the AI ================================
NEWS_API_KEY=
# Cache window in seconds. Raise this if you hit 429s.
NEWS_CACHE_TTL=900

# === Alerts ==============================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === TradingView webhook =================================================
# Shared secret that must appear in the alert JSON as {"secret": "..."}.
TRADINGVIEW_WEBHOOK_SECRET=change_me_to_a_long_random_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8001

# === What to trade =======================================================
# On IG, keep this SHORT (3-5 symbols). IG meters historical price requests
# against a weekly allowance and a long watchlist exhausts it in hours.
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA,AMZN
# Alpaca crypto symbols, e.g. CRYPTO_WATCHLIST=BTC/USD,ETH/USD
# Leave empty on IG: it offers no crypto to UK retail clients.
CRYPTO_WATCHLIST=

# === Trading mode ========================================================
# paper | live — live ALSO requires CONFIRM_LIVE=I_UNDERSTAND_THE_RISK and
# the broker's own switch (ALPACA_PAPER=false, or IG_DEMO=false).
# Stay on paper until proven.
TRADING_MODE=paper
CONFIRM_LIVE=
# alert = draft the trade and wait for your approval (recommended)
# auto  = place the order automatically (advanced, higher risk — earn it)
EXECUTION_MODE=alert
# Minutes an unapproved signal stays actionable before it expires.
APPROVAL_TTL_MINUTES=45

# === Risk management =====================================================
RISK_PER_TRADE_PCT=1.0        # max % of account risked on any single trade
DAILY_LOSS_LIMIT_PCT=3.0      # stop trading for the day at -3%
MAX_DRAWDOWN_PCT=15.0         # pause + review the system at -15%
MAX_OPEN_POSITIONS=5
MAX_CORRELATED_POSITIONS=2    # don't stack 5 tech longs
MAX_PORTFOLIO_RISK_PCT=6.0    # total open risk across all positions
MIN_RISK_REWARD=1.5           # reject setups below this R:R
# Cap any one position at % of equity. This interacts with RISK_PER_TRADE_PCT:
# a full-risk position needs notional of risk% / stop-distance%, so 1% risk
# against a 2% stop wants 50% of equity. Set this lower and tight-stop trades
# get trimmed below your 1% risk budget (safe, but not what you configured).
# IGNORED on IG — see IG_MAX_EXPOSURE_PCT above, which does this job instead.
MAX_POSITION_PCT=50.0
MIN_CONFIDENCE=0.6            # reject AI setups below this confidence

# === Scheduling ==========================================================
SCAN_INTERVAL_MINUTES=15

# Start the scan loop as soon as the server starts, with no click.
# Off by default: every cycle costs Claude API calls, and in auto mode it
# places orders. Leave it false and use the Start button on the dashboard;
# set it true only for an unattended host you want scanning on boot.
AUTOSTART_SCANNER=false

# ---------------------------------------------------------------------
# Reaching the dashboard from somewhere other than this machine
# ---------------------------------------------------------------------
# Leave DASHBOARD_PASSWORD empty and the dashboard serves ONLY this
# machine. That is right for a laptop and it needs no setup.
#
# Set it before putting the bot on any host that is reachable from the
# internet. Everything except /api/live and the webhooks then requires
# it: approving a signal sends a real order to your broker, and
# /api/portfolio reads out your positions.
#
# Use a long random value, e.g.  openssl rand -base64 24
# Serve it over HTTPS. Basic auth sends the password in base64, which is
# encoding, not encryption.
DASHBOARD_USER=trader
DASHBOARD_PASSWORD=

# Where the trade journal lives. Relative paths sit under the repo.
# On a host, point these at a mounted volume so a deploy does not wipe
# the journal:  DATA_DIR=/data  and  LOG_DIR=/data/logs
# DATA_DIR=data
# LOG_DIR=logs
DAILY_REPORT_TIME=16:15       # 24h clock, US/Eastern
MARKET_HOURS_ONLY=true

# === Logging =============================================================
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data


# ##########################################################################
#  PREDICTION-MARKET BOT  (Polymarket/Kalshi — separate legacy system)
#  Only needed if you run the agents/ + backend/ prediction-market pipeline.
# ##########################################################################

# === Polymarket ===
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_PRIVATE_KEY=your_polymarket_wallet_private_key_here
POLYMARKET_BASE_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# === Kalshi ===
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_EMAIL=your_kalshi_email_here
KALSHI_PASSWORD=your_kalshi_password_here
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# === Social Data ===
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=TradingBot/1.0

# === Database ===
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/tradingbot
REDIS_URL=redis://localhost:6379/0

# === App ===
SECRET_KEY=change_this_to_a_long_random_secret_key
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# === Prediction-market risk controls ===
MAX_DAILY_LOSS_USD=500
MAX_POSITION_SIZE_USD=200
MAX_PORTFOLIO_EXPOSURE_USD=2000
MIN_EDGE_THRESHOLD=0.05
MIN_LIQUIDITY_USD=10000
MIN_CONFIDENCE_SCORE=0.65
